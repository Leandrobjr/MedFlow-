// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users          User[]
  patients       Patient[]
  staff          Staff[]
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  transactions   Transaction[]
  dailyClosures  DailyClosure[]
  medicalFees    MedicalFee[]
  scheduleConfigs ScheduleConfig[]
  scheduleBlocks ScheduleBlock[]
  procedures     Procedure[]
  suppliers      Supplier[]

  @@map("tenants")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  name      String
  password  String
  role      String   @default("receptionist") // owner, admin, doctor, receptionist
  status    String   @default("active")
  tenantId  String   @map("tenant_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  staffProfile Staff?
  createdTransactions Transaction[] @relation("TransactionCreatedBy")

  @@map("users")
}

model Patient {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  cpf         String   @unique
  email       String?
  phone       String
  birthDate   DateTime @map("birth_date")
  gender      String?
  address     String?
  city        String?
  state       String?
  zipCode     String?  @map("zip_code")
  allergies   String?  @db.Text
  medications String?  @db.Text
  tenantId    String   @map("tenant_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant          @relation(fields: [tenantId], references: [id])
  appointments Appointment[]
  medicalRecords MedicalRecord[]
  transactions Transaction[]

  @@map("patients")
}

model Staff {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String?  @unique @map("user_id") @db.Uuid
  name           String
  email          String?
  phone          String?
  role           String   // doctor, receptionist, admin, manager
  specialty      String?  // Apenas para médicos/especialistas
  crm            String?  // Registro profissional (CRM, CRP, CREFITO, etc)
  crmState       String?  @map("crm_state")
  rqe            String?  // Registro de Especialização
  rqeState       String?  @map("rqe_state")
  
  // Regras de Repasse
  commissionType  String   @default("PERCENTAGE") @map("commission_type") // PERCENTAGE, FIXED
  commissionRate  Decimal? @default(0) @map("commission_rate") @db.Decimal(5, 2) // Porcentagem (ex: 70.00 para 70%)
  fixedCommission Decimal? @default(0) @map("fixed_commission") @db.Decimal(10, 2) // Valor fixo por atendimento
  
  tenantId       String   @map("tenant_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  appointments   Appointment[]
  medicalRecords MedicalRecord[]
  transactions   Transaction[]
  closedCaixas   DailyClosure[]
  medicalFees    MedicalFee[]
  scheduleConfig ScheduleConfig?
  scheduleBlocks ScheduleBlock[]
  staffProcedures StaffProcedure[]

  @@map("staff")
}

model Appointment {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @map("patient_id") @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  procedureId String   @map("procedure_id") @db.Uuid
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  status      String   @default("scheduled")
  type        String   @default("consultation")
  observations String?  @db.Text
  
  googleEventId String? @map("google_event_id")
  
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  patient     Patient  @relation(fields: [patientId], references: [id])
  staff       Staff    @relation(fields: [staffId], references: [id])
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  procedure   Procedure @relation(fields: [procedureId], references: [id])
  medicalRecord MedicalRecord?
  transaction   Transaction?

  @@map("appointments")
  @@index([startTime, endTime])
  @@index([staffId, startTime])
}

model MedicalRecord {
  id            String   @id @default(uuid()) @db.Uuid
  appointmentId String   @unique @map("appointment_id") @db.Uuid
  patientId     String   @map("patient_id") @db.Uuid
  staffId       String   @map("staff_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  
  anamnesis     String?  @db.Text
  physicalExam  String?  @map("physical_exam") @db.Text
  diagnosis     String?  @db.Text
  prescription  String?  @db.Text
  conduct       String?  @db.Text
  
  isFinalized   Boolean  @default(false) @map("is_finalized")
  finalizedAt   DateTime? @map("finalized_at")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  patient       Patient     @relation(fields: [patientId], references: [id])
  staff         Staff       @relation(fields: [staffId], references: [id])
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  addendums     MedicalAddendum[]

  @@map("medical_records")
}

model MedicalAddendum {
  id              String   @id @default(uuid()) @db.Uuid
  medicalRecordId String   @map("medical_record_id") @db.Uuid
  content         String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])

  @@map("medical_addendums")
}

model Transaction {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  patientId     String?  @map("patient_id") @db.Uuid
  staffId       String?  @map("staff_id") @db.Uuid
  appointmentId String?  @unique @map("appointment_id") @db.Uuid
  createdById   String?  @map("created_by_id") @db.Uuid
  
  type          String   
  category      String   
  amount        Decimal  @db.Decimal(10, 2)
  method        String?  
  description   String?
  status        String   @default("completed")
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  patient       Patient?    @relation(fields: [patientId], references: [id])
  staff         Staff?      @relation(fields: [staffId], references: [id])
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  createdBy     User?       @relation("TransactionCreatedBy", fields: [createdById], references: [id])
  medicalFee    MedicalFee?

  @@map("transactions")
}

model DailyClosure {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  closedById      String   @map("closed_by_id") @db.Uuid
  
  date            DateTime @db.Date
  totalIncome     Decimal  @map("total_income") @db.Decimal(10, 2)
  totalExpense    Decimal  @map("total_expense") @db.Decimal(10, 2)
  netBalance      Decimal  @map("net_balance") @db.Decimal(10, 2)
  
  observations    String?  @db.Text
  status          String   @default("closed")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  closedBy        Staff    @relation(fields: [closedById], references: [id])

  @@unique([tenantId, date])
  @@map("daily_closures")
}

model MedicalFee {
  id              String   @id @default(uuid()) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid // O médico que recebe
  transactionId   String   @unique @map("transaction_id") @db.Uuid // Vínculo com o pagamento original
  
  grossAmount     Decimal  @map("gross_amount") @db.Decimal(10, 2) // Valor total pago pelo paciente
  commissionRate  Decimal  @map("commission_rate") @db.Decimal(5, 2) // Porcentagem aplicada na época
  feeAmount       Decimal  @map("fee_amount") @db.Decimal(10, 2) // Valor que o médico recebe
  
  status          String   @default("pending") // pending, paid, cancelled
  paidAt          DateTime? @map("paid_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  staff           Staff       @relation(fields: [staffId], references: [id])
  transaction     Transaction @relation(fields: [transactionId], references: [id])

  @@map("medical_fees")
}

// Configuração de Agenda por Profissional
model ScheduleConfig {
  id              String   @id @default(uuid()) @db.Uuid
  staffId         String   @unique @map("staff_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  
  // Duração padrão da consulta em minutos
  defaultDuration Int      @default(30) @map("default_duration")
  
  // Configuração de dias da semana (JSON: { "monday": { "enabled": true, "periods": [...] }, ... })
  // Cada período: { "start": "08:00", "end": "12:00" }
  weeklySchedule  String   @db.Text @map("weekly_schedule") // JSON string
  
  isActive        Boolean  @default(true) @map("is_active")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  staff           Staff    @relation(fields: [staffId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@map("schedule_configs")
}

// Bloqueios Ocasionais de Agenda
model ScheduleBlock {
  id              String   @id @default(uuid()) @db.Uuid
  staffId         String   @map("staff_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  
  // Tipo: "date" (dia inteiro) ou "period" (período específico)
  blockType       String   @map("block_type") // "date" | "period"
  
  // Para blockType = "date": apenas startDate é usado
  // Para blockType = "period": startDate e endDate definem o período
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  
  // Para blockType = "period": horários específicos
  startTime       String?  @map("start_time") // "HH:mm"
  endTime         String?  @map("end_time")   // "HH:mm"
  
  reason          String?  @db.Text // Motivo do bloqueio
  isRecurring     Boolean  @default(false) @map("is_recurring") // Bloqueio recorrente (ex: feriados)
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  staff           Staff    @relation(fields: [staffId], references: [id])
  tenant          Tenant   @relation(fields: [tenantId], references: [id])

  @@index([staffId, startDate])
  @@map("schedule_blocks")
}

// Cadastro de Procedimentos
model Procedure {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  grossAmount   Decimal  @map("gross_amount") @db.Decimal(10, 2)
  observations  String?  @db.Text
  tenantId      String   @map("tenant_id") @db.Uuid
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  staffProcedures StaffProcedure[]
  appointments Appointment[]

  @@map("procedures")
}

// Cadastro de Fornecedores
model Supplier {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  contactInfo   String?  @map("contact_info") @db.Text // JSON string com telefone, email, endereço, etc
  tenantId      String   @map("tenant_id") @db.Uuid
  
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant   @relation(fields: [tenantId], references: [id])

  @@map("suppliers")
}

// Relacionamento Many-to-Many: Staff ↔ Procedures
model StaffProcedure {
  id          String   @id @default(uuid()) @db.Uuid
  staffId     String   @map("staff_id") @db.Uuid
  procedureId String   @map("procedure_id") @db.Uuid
  
  createdAt   DateTime @default(now()) @map("created_at")

  staff       Staff     @relation(fields: [staffId], references: [id], onDelete: Cascade)
  procedure   Procedure @relation(fields: [procedureId], references: [id], onDelete: Cascade)

  @@unique([staffId, procedureId])
  @@map("staff_procedures")
}
