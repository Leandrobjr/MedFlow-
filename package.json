{
  "name": "medflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --concurrency=1",
    "build": "turbo run build --concurrency=1",
    "lint": "turbo run lint --concurrency=1",
    "clean": "turbo run clean",
    "db:generate": "pnpm --filter @medflow/db prisma:generate",
    "db:migrate": "pnpm --filter @medflow/db prisma:migrate",
    "db:seed": "pnpm --filter @medflow/db seed"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.5",
    "@typescript-eslint/eslint-plugin": "^8.53.1",
    "@typescript-eslint/parser": "^8.53.1",
    "eslint": "9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.0.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
