[
  {
    "id": "TC001",
    "title": "Create an appointment from Agenda day view and see it on the calendar",
    "description": "Verifies a user can create a new appointment for a selected professional and see the appointment card displayed in the day view calendar.",
    "category": "Appointments (Agenda)",
    "priority": "High",
    "steps": [
      {
        "type": "action",
        "description": "Navigate to /login"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_USER}}\" into the email/username field"
      },
      {
        "type": "action",
        "description": "Type \"{{LOGIN_PASSWORD}}\" into the password field"
      },
      {
        "type": "action",
        "description": "Click the \"Entrar\"/\"Login\" button"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/dashboard\""
      },
      {
        "type": "action",
        "description": "Click on \"Agenda\" in the main navigation"
      },
      {
        "type": "assertion",
        "description": "Verify URL contains \"/dashboard/agenda\""
      },
      {
        "type": "action",
        "description": "Select a professional from the professional filter"
      },
      {
        "type": "action",
        "description": "Click on the \"Dia\" (Day) view toggle"
      },
      {
        "type": "action",
        "description": "Click the \"Novo agendamento\"/\"New Appointment\" button"
      },
      {
        "type": "action",
        "description": "Select a patient in the patient field"
      },
      {
        "type": "action",
        "description": "Select a procedure in the procedure field"
      },
      {
        "type": "action",
        "description": "Select a time in the time field"
      },
      {
        "type": "action",
        "description": "Click the \"Salvar\"/\"Save\" button"
      },
      {
        "type": "assertion",
        "description": "Verify an appointment card is visible in the calendar for the selected time"
      }
    ]
  },
